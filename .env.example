# Сервер Express
PORT=8001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ИИ-модуль (модуль ai/)
# Ключ Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
Google_api=

# Ключ Tavily Search API для поиска прямых заказов (https://tavily.com)
TAVILY_API_KEY=

# Ключ Exa Search API для семантического веб-поиска (https://exa.ai)
EXA_API_KEY=

# Локальный шлюз OmniRoute (опционально)
USE_OMNIROUTE=false
OMNIROUTE_URL=http://127.0.0.1:20128/v1
