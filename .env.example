# Сервер Express
PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ИИ-модуль (модуль ai/)
# Ключ Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
Google_api=

# Ключ Tavily Search API для живого веб-поиска тендеров (https://tavily.com)
TAVILY_API_KEY=

# OpenRouter API (альтернативный роутер моделей, https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Локальный шлюз OmniRoute (опционально)
USE_OMNIROUTE=false
OMNIROUTE_URL=http://127.0.0.1:20128/v1
