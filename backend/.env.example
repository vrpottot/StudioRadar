# Сервер Express; данные хранятся в PostgreSQL / Supabase
PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Серверная строка подключения из Supabase Connect (direct или session pooler).
# Пароль кодируется для URL. Значение никогда не передаётся во frontend.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full

# Поиск прямых заказов (можно подключить оба провайдера)
EXA_API_KEY=
TAVILY_API_KEY=

# Квалификация заказов через Google Gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
