# Настройки базы данных (по умолчанию локальный SQLite)
DATABASE_URL=sqlite+aiosqlite:///./leads.db

# Настройки сервера
SERVER_HOST=127.0.0.1
SERVER_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenRouter API (Работает в РФ без VPN напрямую, https://openrouter.ai/keys)
# Рекомендуемые модели:
# - deepseek/deepseek-chat (DeepSeek V3 - супер-качество на русском, низкая цена)
# - google/gemini-2.0-flash-001 (Gemini через OpenRouter без блокировок в РФ)
# - meta-llama/llama-3.3-70b-instruct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Telegram API (получить на my.telegram.org для Telethon / GramJS)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Telegram Bot для мгновенных алертов заказчику
ALERT_BOT_TOKEN=
MANAGER_CHAT_ID=
