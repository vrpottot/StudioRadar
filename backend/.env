# Настройки базы данных
DATABASE_URL=sqlite+aiosqlite:///./leads.db

# Сервер
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Telegram MTProto (Telethon) - Получить бесплатно на https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=studioradar_session

# Локальный AI-шлюз OmniRoute (http://localhost:20128)
USE_OMNIROUTE=true
OMNIROUTE_URL=http://127.0.0.1:20128/v1

# OpenRouter API (Облачный роутер, работает в РФ без VPN напрямую, https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/deepseek/deepseek-chat

# Google api (резерв)
Google_api= AQ.Ab8RN6Lp4nHMkBosOKtEEglXE5tGMcwgWKWFoRVLvlMLqsLHnA